{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traker-jodhani",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "track",
      "database_id": "4d500da3-f329-4041-a4e9-5395a517e9a8"
    }
  ]
}
