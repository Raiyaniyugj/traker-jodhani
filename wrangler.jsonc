{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traker-jodhani",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "traker-jodhani-db",
      "database_id": "03c81cac-b23a-4ac9-bb7a-cba42ec58744"
    }
  ]
}
